# OpenAI Responses API
OPENAI_API_KEY=
# Override this with a model available to your account when necessary.
OPENAI_MODEL=gpt-4.1-mini

# Resend email API
RESEND_API_KEY=
SENDER_EMAIL=AI Daily <digest@your-verified-domain.example>
RECIPIENT_EMAIL=your-name@outlook.com

# Optional tuning
MAX_ITEMS=12
REQUEST_TIMEOUT_SECONDS=20
